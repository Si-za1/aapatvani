# AapatVani AI — environment variables.
# Copy to .env.local for local development. Never commit real values.
# With nothing set, the app runs locally on a file store (.data/) with passcode sign-in,
# and saves reports with "AI pending" until Gemini is configured.

# ---------------------------------------------------------------- Gemini
# Option A (recommended on Cloud Run): Gemini through Gemini Enterprise Agent Platform.
# Authenticates with the Cloud Run service account (or `gcloud auth application-default login` locally).
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
#
# Option B: Gemini Developer API key from Google AI Studio (keep it server-side; never NEXT_PUBLIC_).
# GEMINI_API_KEY=

# Optional model overrides (defaults in src/config/models.ts).
# GEMINI_MODEL_EXTRACTION=gemini-3.8-flash
# GEMINI_MODEL_REASONING=gemini-3.8-flash
# GEMINI_MODEL_DRAFTING=gemini-3.8-flash
# GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# ---------------------------------------------------------------- Data and media
# local (default): JSON files in .data/ — development only.
# firestore: Cloud Firestore through the Admin SDK (use this on Cloud Run).
DATA_BACKEND=local
# FIRESTORE_DATABASE_ID=(default)
# Media goes to Cloud Storage when STORAGE_BUCKET is set (or MEDIA_BACKEND=gcs); otherwise .data/media.
# STORAGE_BUCKET=your-project-id.firebasestorage.app
# MEDIA_BACKEND=local
# LOCAL_DATA_DIR=.data

# ---------------------------------------------------------------- Reviewer sign-in
# passcode (default): shared passcode + signed session cookie. Good for local work and demos.
# firebase: Firebase Authentication (email/password) + Admin SDK session cookies.
AUTH_MODE=passcode
# Required in production: 32+ random characters, e.g. `openssl rand -base64 48`.
# SESSION_SECRET=
# Required in production for passcode mode (local default: demo-reviewer).
# REVIEWER_PASSCODE=
# Firebase mode: who may review (comma-separated emails), unless their account has the `reviewer` custom claim.
# REVIEWER_EMAILS=reviewer@example.org
# Firebase web config (public values, read at runtime and passed to the sign-in page).
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_APP_ID=
# Shown on the sign-in page for judges, e.g. "Demo reviewer: demo@aapatvani.app / …"
# DEMO_LOGIN_HINT=

# ---------------------------------------------------------------- App settings
DEFAULT_REGION=np
# synthetic | historical | operational — label applied to new public submissions.
DEFAULT_DATA_LABEL=synthetic
# Public report submissions allowed per IP per 10 minutes (per server instance).
# REPORT_RATE_LIMIT=20
# Map tiles (OpenStreetMap by default; respect the tile usage policy).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
