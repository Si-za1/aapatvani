{
  "name": "aapatvani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/prepare-region.ts --fetch",
    "data:prepare": "tsx scripts/prepare-region.ts --input",
    "check:models": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/check-models.ts",
    "seed": "tsx --conditions=react-server scripts/seed-demo.ts",
    "seed:reset": "rm -rf .data/db .data/media",
    "eval": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/eval.ts",
    "test:multimodal": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/test-multimodal.ts",
    "bench": "tsx --conditions=react-server scripts/bench.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exifr": "^7.1.3",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "AI-assisted disaster report triage and impact analysis (Gemini + deterministic geography + human review).",
  "engines": {
    "node": ">=20.9.0"
  }
}
